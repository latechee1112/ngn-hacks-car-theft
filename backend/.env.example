# Copy to .env and fill in real values. Never commit .env.
ENV=development

# Comma-separated. Add your unpacked/packed extension origin once you have it
CORS_ORIGINS=http://localhost:5173, chrome-extension://<your-extension-id>

# Featherless AI (OpenAI-compatible API)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_TIMEOUT_SECONDS=8.0

# Request limits
MAX_BLOCKS_PER_REQUEST=150
MAX_BLOCK_TEXT_LENGTH=500
MAX_REQUEST_BYTES=300000

# Rate limiting
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_CALIBRATION=10/minute
